<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 redirects from old URLs
  RewriteRule ^site/(.*)$ /$1 [R=301,L]
  RewriteRule ^site/?$ / [R=301,L]

  RewriteRule ^blog/construction-dx-cases/?$ /blog/construction-dx-success-cases/ [R=301,L]
  RewriteRule ^blog/slack-chatgpt-sales-support/?$ /blog/slack-chatgpt-secure-helpdesk/ [R=301,L]
  RewriteRule ^blog/line-ai-reservation-system/?$ /blog/line-ai-personalized-reservation/ [R=301,L]
  RewriteRule ^blog/ai-offshore-trends-2026/?$ /blog/offshore-development-future/ [R=301,L]
  RewriteRule ^blog/backlog-ai-task-automation/?$ /blog/backlog-ai-project-summary/ [R=301,L]
  RewriteRule ^blog/jira-ai-ticket-management/?$ /blog/jira-ai-automated-ticketing/ [R=301,L]

  # Add trailing slash to directories without extension
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Serve index.html for directories
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*)$ $1index.html [L]

  # Static file fallback (404 for truly unknown paths)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 1 day"
</IfModule>

ErrorDocument 404 /index.html
